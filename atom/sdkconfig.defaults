# AtomS3R-CAM: ESP32-S3, 8 MB flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Logs and the setup console on the USB-C port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE peripheral only (NimBLE), one phone at a time
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="balancing robot"

# Camera frame buffers in PSRAM
CONFIG_CAMERA_TASK_STACK_SIZE=4096

# 1 ms ticks: the bridge waits in milliseconds (at 100 Hz, 5 ms rounds to 0 and spins)
CONFIG_FREERTOS_HZ=1000

# The USB setup console runs in the main task; AT+WIFISCAN? needs a long reply buffer
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
